<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
            configChanges: Link runs on a single-use link token. Letting Android
            recreate this activity on a rotation, dark-mode switch, font/locale
            change or window resize would reload Link from that already-used
            token and dead-end the user on "Session expired". Handling these
            changes in place keeps the running WebView session alive.
        -->
        <activity
            android:name="com.meshconnect.link.ui.LinkActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode"
            android:theme="@style/MeshLink.Theme.Catalog" />
    </application>

    <queries>
        <package android:name="org.toshi" />
    </queries>
</manifest>